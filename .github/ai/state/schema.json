{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/muradovnb-cyber/isola-business-suite/main/.github/ai/state/schema.json",
  "title": "ISOLA Orchestrator — GPT-facing state projection",
  "description": "Simplified, GPT-friendly projection of orchestrator state. Overwritten on every state transition. Lives on the ai/orchestrator-state branch. Contract v2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "current_task", "stage", "agent", "attempt", "last_commit", "last_pr", "last_review", "blockers", "next_action", "updated_at"],
  "properties": {
    "status":       { "enum": ["IDLE", "QUEUED", "RUNNING", "REVIEW", "FIXING", "PASSED", "BLOCKED", "FAILED"] },
    "current_task": { "type": ["string", "null"], "pattern": "^TASK-[A-Za-z0-9_-]{1,72}$" },
    "stage":        { "enum": ["planning", "implementing", "testing", "reviewer", "done", null] },
    "agent":        { "enum": ["gpt-architect", "claude-runner", "gpt-reviewer", null] },
    "attempt":      { "type": "integer", "minimum": 0, "maximum": 20 },
    "last_commit":  { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "last_pr":      {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url"],
          "properties": {
            "number": { "type": ["integer", "null"] },
            "url":    { "type": ["string", "null"], "format": "uri" }
          }
        }
      ]
    },
    "last_review":  {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "attempt"],
          "properties": {
            "decision": { "enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"] },
            "attempt":  { "type": "integer", "minimum": 1, "maximum": 20 },
            "url":      { "type": ["string", "null"] },
            "approved_for_deploy": { "type": ["boolean", "null"] }
          }
        }
      ]
    },
    "blockers":     { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
    "next_action":  { "type": ["string", "null"], "maxLength": 500 },
    "updated_at":   { "type": "string", "format": "date-time" }
  }
}
