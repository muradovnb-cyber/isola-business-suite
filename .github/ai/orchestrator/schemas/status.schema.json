{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/muradovnb-cyber/isola-business-suite/main/.github/ai/orchestrator/schemas/status.schema.json",
  "title": "ISOLA Orchestrator Current Status",
  "description": "The single machine-readable file describing where the orchestrator is right now. Overwritten on every state transition; historical snapshots live in executions/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "run_id", "status", "attempt", "updated_at"],
  "properties": {
    "task_id":     { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "run_id":      { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "status":      { "enum": ["PENDING","PLANNING","IMPLEMENTING","TESTING","WAITING_REVIEW","CHANGES_REQUIRED","APPROVED","DEPLOYING","DONE","FAILED","BLOCKED","IDLE"] },
    "attempt":     { "type": "integer", "minimum": 0, "maximum": 20 },
    "max_attempts":{ "type": "integer", "minimum": 1, "maximum": 20 },
    "branch":      { "type": ["string","null"] },
    "commit":      { "type": ["string","null"] },
    "pr":          {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "properties": { "number": {"type":["integer","null"]}, "url": {"type":["string","null"]} } }
      ]
    },
    "tests":       { "enum": ["PASS","FAIL","SKIPPED","PENDING", null] },
    "review":      { "enum": ["PENDING","APPROVED","CHANGES_REQUIRED","BLOCKED", null] },
    "deployment":  { "enum": ["NOT_REQUESTED","PENDING","SUCCESS","FAILED", null] },
    "next_action": { "type": ["string","null"] },
    "error":       { "type": ["string","null"] },
    "started_at":  { "type": ["string","null"], "format": "date-time" },
    "updated_at":  { "type": "string", "format": "date-time" },
    "history":     {
      "type": "array",
      "items": { "type": "object", "properties": { "ts": {"type":"string"}, "status": {"type":"string"}, "note": {"type":"string"} } },
      "maxItems": 100
    }
  }
}
