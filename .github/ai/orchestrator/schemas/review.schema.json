{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/muradovnb-cyber/isola-business-suite/main/.github/ai/orchestrator/schemas/review.schema.json",
  "title": "ISOLA Orchestrator GPT Review Record",
  "description": "One file per review. Points back to the execution it reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id","run_id","attempt","decision","created_at"],
  "properties": {
    "task_id":     { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "run_id":      { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "attempt":     { "type": "integer", "minimum": 1 },
    "decision":    { "enum": ["APPROVED","CHANGES_REQUIRED","BLOCKED"] },
    "approved_for_deploy": { "type": "boolean" },
    "created_at":  { "type": "string", "format": "date-time" },
    "reviewer":    { "type": "string", "description": "model+temp, e.g. 'gpt-4o@0.1'" },
    "summary":     { "type": ["string","null"] },
    "feedback": {
      "type": ["object","null"],
      "properties": {
        "problem":              { "type": "string" },
        "why":                  { "type": "string" },
        "issues":               { "type": "array", "items": { "type": "string" } },
        "required_changes":     { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria":  { "type": "string" }
      }
    }
  }
}
