{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/muradovnb-cyber/isola-business-suite/main/.github/ai/tasks/SCHEMA.json",
  "title": "ISOLA Orchestrator Task",
  "description": "One immutable submission per file. Task files live in .github/ai/tasks/ and are the queue the orchestrator dispatches from. State (RUNNING/PASSED/…) is tracked on the ai/orchestrator-state branch under .github/ai/orchestrator/, NOT in the task file itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "objective", "created_at"],
  "properties": {
    "id":          { "type": "string", "pattern": "^TASK-[A-Za-z0-9_-]{1,72}$" },
    "status":      { "enum": ["QUEUED", "CANCELLED"], "description": "Only QUEUED tasks are dispatched. CANCELLED tasks are ignored. Runtime states (RUNNING/REVIEW/FIXING/PASSED/BLOCKED/FAILED) live in orchestrator/CURRENT_STATUS.json, not here." },
    "priority":    { "enum": ["low", "normal", "high"], "default": "normal" },
    "source":      { "type": "string", "description": "Who created this task, e.g. 'gpt', 'owner', 'cron', 'issue-#42'" },
    "created_at":  { "type": "string", "format": "date-time" },
    "created_by":  { "type": ["string", "null"] },
    "objective":   { "type": "string", "minLength": 5, "maxLength": 500, "description": "Human-readable task title / one-line goal" },
    "context":     { "type": "string", "maxLength": 4000, "description": "Optional background the executor should know" },
    "files_to_inspect": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "requirements":     { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "tests_required":   { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "security_requirements": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "do_not_change":    { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "deployment_policy": { "enum": ["NO_DEPLOY", "APPROVED_FOR_DEPLOY_MANUAL"], "default": "NO_DEPLOY" },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
  }
}
